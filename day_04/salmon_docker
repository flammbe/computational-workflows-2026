FROM debian:13-slim

LABEL image.author.name="flammbe"
LABEL image.author.email="flammbe@example.com"

# Install dependencies

RUN apt-get update && apt-get install -y cmake && apt-get install -y wget && apt-get install -y curl && apt-get install -y tar
# cmake is needed as dependency for salmon. wget, curl and tar ar needed to download & build salmon.

# Download and install Salmon

RUN curl -L --output ./salmon.tar.gz https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz
# -L is required since this is from GitHub.

RUN tar -xzf ./salmon.tar.gz -C /opt 
# x: extraction of files; z: unpackes gzipped files; f: file; C: set path to opt/ 

# Set the PATH environment variable (to /usr/bin)

ENV PATH="/opt/salmon-1.5.2_linux_x86_64/bin:${PATH}"
# here i added salmon to the path var, to make it callable with 'salmon'.
